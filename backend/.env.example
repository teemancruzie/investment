# Server
PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/investment_platform

# Auth
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=replace_with_another_long_random_string
JWT_REFRESH_EXPIRES_IN=30d

# Frontend
CLIENT_URL=http://localhost:5173

# Uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=5

# Email (optional)
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM=no-reply@example.com

# --- Crypto deposit addresses (manual proof-of-payment flow) ---
DEPOSIT_ADDRESS_USDT_TRC20=
DEPOSIT_ADDRESS_USDT_ERC20=
DEPOSIT_ADDRESS_USDT_BEP20=
DEPOSIT_ADDRESS_USDC_ERC20=
DEPOSIT_ADDRESS_USDC_SOL=
DEPOSIT_ADDRESS_USDC_BEP20=
DEPOSIT_ADDRESS_BTC=
DEPOSIT_ADDRESS_ETH=
DEPOSIT_ADDRESS_BNB=
DEPOSIT_ADDRESS_TRX=
DEPOSIT_ADDRESS_SOL=
